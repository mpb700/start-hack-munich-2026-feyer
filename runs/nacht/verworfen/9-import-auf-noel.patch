+        """
+        Multiply a batch of matrices with a batch of vectors.
+
+        Parameters
+        ----------
+        matrix_batch : jnp.ndarray
+            Shape (B, N, N).
+        vector_batch : jnp.ndarray
+            Shape (B, N).
+
+        Returns
+        -------
+        product : jnp.ndarray
+            Shape (B, N).
+        """
+        return jnp.einsum("bij,bj->bi", matrix_batch, vector_batch)
