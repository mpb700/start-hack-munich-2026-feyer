+    def solve_rows(self, b, trans="N"):
+        """The same for one right-hand side of shape (size, F), one row per unknown; returns a new array."""
+        x = self.solve(np.ascontiguousarray(b.T, dtype=complex)[:, :, None], trans, overwrite=True)
